{
  "name": "copy-of-copy-of-copy-of-copy-of-ai-storyboard-generator-2.2.1",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "ng serve",
    "build": "ng build",
    "preview": "ng serve --configuration=production",
    "electron:serve": "wait-on http://localhost:4200 && electron electron/main.cjs",
    "electron:dev": "concurrently \"npm run dev\" \"npm run electron:serve\"",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "rxjs": "^7.8.2",
    "@google/genai": "^1.20.0",
    "@angular/compiler": "^20.1.0",
    "@angular/platform-browser": "^20.1.0",
    "@angular/core": "^20.1.0",
    "@angular/build": "^20.1.0",
    "@angular/cli": "^20.1.0",
    "@angular/common": "^20.1.0",
    "@angular/compiler-cli": "^20.1.0",
    "tailwindcss": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "concurrently": "^9.1.2",
    "electron": "^34.1.1",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.aiscene.editor",
    "productName": "AI Scene Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}